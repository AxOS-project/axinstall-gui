<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <template class="WifiEntry" parent="AdwActionRow">
    <property name="title">Network</property>
    <property name="subtitle">Security</property>
    <property name="use-markup">false</property>
    <property name="activatable">true</property>
    <child type="prefix">
      <object class="GtkImage" id="signal_icon">
        <property name="icon-name">network-wireless-signal-excellent-symbolic</property>
        <property name="valign">center</property>
      </object>
    </child>
    <child type="suffix">
      <object class="GtkBox">
        <property name="spacing">8</property>
        <property name="valign">center</property>
        <child>
          <object class="GtkSpinner" id="connecting_spinner">
            <property name="visible">false</property>
            <property name="valign">center</property>
          </object>
        </child>
        <child>
          <object class="GtkImage" id="lock_icon">
            <property name="icon-name">network-wireless-encrypted-symbolic</property>
            <property name="valign">center</property>
            <property name="visible">false</property>
            <style>
              <class name="dim-label"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkImage" id="status_icon">
            <property name="icon-name">object-select-symbolic</property>
            <property name="valign">center</property>
            <property name="visible">false</property>
            <style>
              <class name="success"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="disconnect_button">
            <property name="label" translatable="true">Disconnect</property>
            <property name="valign">center</property>
            <property name="visible">false</property>
            <style>
              <class name="flat"/>
            </style>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
